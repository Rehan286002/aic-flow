# Local development only. Copy into backend/.env and adjust local credentials.
APP_NAME="AIC-Flow API"
APP_ENV=local
DATABASE_URL=postgresql+psycopg://aic_flow_app:local_dev_postgres_password@localhost:5433/aic_flow
REDIS_URL=redis://:local_dev_redis_password@localhost:6379/0
JWT_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-bytes
JWT_ALGORITHM=HS256
JWT_ISSUER=aic-flow
JWT_AUDIENCE=aic-flow-api
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ALLOWED_ORIGINS=["http://localhost:5173"]
ACCESS_COOKIE_NAME=aic_flow_access
CSRF_COOKIE_NAME=aic_flow_csrf
COOKIE_SAMESITE=lax
COOKIE_SECURE=false
STORAGE_ROOT_DIR=../storage
MALWARE_SCANNER_TYPE=clamav
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
